# ===========================
# App
# ===========================
APP_NAME=Content Trend Intelligence Assistant
APP_ENV=development
LOG_LEVEL=INFO

# ===========================
# MongoDB
# ===========================
MONGODB_URI=your_mongodb_uri
MONGODB_DB_NAME=content_trend_assistant

# ===========================
# OpenAI (chat completions + embeddings)
# ===========================
OPENAI_API_KEY=your_openai_api_key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===========================
# YouTube Data API v3
# ===========================
YOUTUBE_API_KEY=your_youtube_api_key
# Your own channel ID, used for creator-profile building
YOUTUBE_CHANNEL_ID=your_youtube_channel_id
# Comma-separated list of other channel IDs to monitor
YOUTUBE_WATCH_CHANNELS=
# Comma-separated list of search queries to monitor
YOUTUBE_WATCH_QUERIES=

# ===========================
# Reddit (PRAW)
# ===========================
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=content-trend-assistant/1.0
# Comma-separated list of subreddit names (no r/ prefix), e.g. technology,artificial
REDDIT_SUBREDDITS=

# ===========================
# Google Trends (pytrends — no API key required)
# ===========================
GOOGLE_TRENDS_GEO=US
# Comma-separated keywords to track interest-over-time for
GOOGLE_TRENDS_KEYWORDS=

# ===========================
# Gmail API (OAuth2 installed-app flow)
# ===========================
# Path to the OAuth client secrets JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json
# Path where the OAuth token will be cached after first login
GMAIL_TOKEN_FILE=token.json
# Gmail search query used when syncing new mail
GMAIL_QUERY=newer_than:2d

# ===========================
# Notifications — toggle each channel on/off
# ===========================
NOTIFY_DESKTOP_ENABLED=true
NOTIFY_DISCORD_ENABLED=false
NOTIFY_TELEGRAM_ENABLED=false
NOTIFY_EMAIL_ENABLED=false

# Discord
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Email (SMTP) notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_app_password
NOTIFY_EMAIL_TO=your_notification_recipient_email

# ===========================
# Trend scoring — threshold + weights (must not need to sum to 1, but should for interpretability)
# ===========================
TREND_NOTIFY_SCORE_THRESHOLD=0.7
TREND_WEIGHT_GROWTH=0.25
TREND_WEIGHT_ENGAGEMENT=0.2
TREND_WEIGHT_FRESHNESS=0.15
TREND_WEIGHT_SIMILARITY=0.3
TREND_WEIGHT_CROSS_PLATFORM=0.1
